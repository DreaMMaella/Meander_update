# Скопируйте этот файл в apps/main_app/.env и заполните своими значениями.
# .env исключён из git; в репозитории лежит только этот шаблон.
#
# Сборка с учётными данными:
#   cd apps/main_app
#   flutter build linux --release --dart-define-from-file=.env
#
# Без заполненного .env приложение собирается, но OAuth-входы отключены.

GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
GOOGLE_MOBILE_SERVER_CLIENT_ID=
YANDEX_CLIENT_ID=
TELEGRAM_CLIENT_ID=
