<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Profile-сборка — тот же отладочный инструмент, что и debug: её гоняют
         с перехватом трафика. В публикуемом билде (src/main) пользовательских
         корней нет. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
