# Runtime
NODE_ENV=
PORT=
BASE_URL=
CORS_ORIGINS=
ENABLE_DEBUG_ROUTES=

# PostgreSQL
DATABASE_URL=

# Authentication
JWT_SECRET=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WINDOWS_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
# Sign in with Apple: audience identity-токена. Для нативного iOS-входа это
# bundle id (значение по умолчанию в коде), Service ID нужен для веб-редиректа.
APPLE_BUNDLE_ID=com.IILLUMINAT.meadner
APPLE_SERVICE_ID=

# External services
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
IMGBB_KEY=
ONLYSQ_BASE_URL=
ONLYSQ_API_KEY=
ONLYSQ_MODEL=
POLLINATIONS_TOKEN=

# Cloud sync
CLOUD_SYNC_ROOT=
SYNC_SETTINGS_SECRET=

# AI token limits (optional; defaults are defined by the backend)
AI_DEFAULT_TOKENS=
AI_VETERAN_TOKENS=
AI_AD_REWARD_TOKENS=
AI_TOKEN_REFILL_HOURS=

